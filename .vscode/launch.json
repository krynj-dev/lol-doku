{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "command": "npm run dev",
            "name": "FE: start",
            "request": "launch",
            "type": "node-terminal",
            "cwd": "${workspaceFolder}/lol-doku-frontend",
        },
        {
            "name": "Python: Main Script (pro2pro)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/pro2pro.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/scripts",
        },
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Django",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}\\lol-doku-backend\\manage.py",
            "args": [
                "runserver"
            ],
            "django": true,
            "justMyCode": true,
            "python": "${workspaceFolder}\\lol-doku-backend\\.venv\\Scripts\\python.exe",
            "cwd": "${workspaceFolder}\\lol-doku-backend"
        },
        {
            "name": "Python: Main Script (update)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "--update"
            ]
        },
        {
            "name": "Python: Main Script (update images)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "--update-img"
            ]
        },
        {
            "name": "Python: Main Script (notoriety)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "--notoriety"
            ]
        },
        {
            "name": "Python: Main Script (gensql)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/scripts",
            "args": [
                "--sqlgen"
            ]
        }
    ]
}